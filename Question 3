<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Travel Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .destination-card { position: relative; box-shadow: 0 4px 8px rgba(0,0,0,0.1); border-radius: 10px; margin-bottom: 20px; }
        .destination-card:hover { transform: translateY(-5px); }
        @media (max-width: 768px) { .destination-card { margin: 10px; } }
    </style>
</head>
<body>
    <div class="container">
        <header class="text-center my-4">
            <h1>Travel Booking</h1>
        </header>
        <section id="search" class="mb-4">
            <form class="row g-3">
                <div class="col-md-4">
                    <input type="text" class="form-control" id="searchInput" placeholder="Search destinations" autocomplete="on">
                </div>
                <div class="col-md-4">
                    <input type="date" class="form-control" id="dateInput">
                </div>
                <div class="col-md-4">
                    <input type="range" class="form-control" id="budgetInput" min="100" max="5000" value="1000">
                    <span id="budgetValue">Budget: $1000</span>
                </div>
            </form>
        </section>
        <section id="destinations" class="row">
            <div class="col-md-4">
                <div class="card destination-card" data-destination="Paris">
                    <img src="https://via.placeholder.com/300" class="card-img-top" alt="Paris">
                    <div class="card-body">
                        <h5 class="card-title">Paris <span class="badge bg-primary">Popular</span></h5>
                        <p class="card-text">Romantic city.</p>
                        <button class="btn btn-primary book-btn">Book Now</button>
                    </div>
                </div>
            </div>
            <!-- Add more cards similarly -->
        </section>
        <div class="modal fade" id="bookingModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Book Ticket</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="bookingForm">
                            <input type="text" class="form-control mb-2" placeholder="Name" required>
                            <input type="email" class="form-control mb-2" placeholder="Email" required>
                            <button type="submit" class="btn btn-success">Confirm Booking</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            // Dynamic load and validation
            $('.book-btn').on('click', function() {
                let dest = $(this).closest('.card').data('destination');
                $('#bookingModal').modal('show');
                // Simulate dynamic load
                console.log('Loading details for ' + dest);
            });
            $('#bookingForm').on('submit', function(e) {
                if (!$('input[type="text"]').val() || !$('input[type="email"]').val()) {
                    e.preventDefault();
                    alert('Fill all fields.');
                }
            });
            // Search filtering
            $('#searchInput').on('keyup', function() {
                let query = $(this).val().toLowerCase();
                $('.destination-card').each(function() {
                    $(this).toggle($(this).data('destination').toLowerCase().includes(query));
                });
            });
            // Smooth scrolling
            $('a[href^="#"]').on('click', function(e) {
                e.preventDefault();
                $('html, body').animate({ scrollTop: $($(this).attr('href')).offset().top }, 500);
            });
            // Update budget
            $('#budgetInput').on('input', function() {
                $('#budgetValue').text('Budget: $' + $(this).val());
            });
        });
    </script>
</body>
</html>
