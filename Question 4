<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personal Portfolio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { font-family: Arial, sans-serif; background: #f4f4f4; }
        .section { padding: 50px 0; }
        .card { border-radius: 10px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); transition: transform 0.3s; }
        .card:hover { transform: translateY(-5px); }
        .text-effect { text-shadow: 1px 1px 2px rgba(0,0,0,0.5); }
        #clock { font-size: 1.2em; color: #007bff; }
        .profile-img { width: 150px; height: 150px; border-radius: 50%; object-fit: cover; margin-bottom: 20px; }
        @media (max-width: 768px) { .section { padding: 20px 0; } .profile-img { width: 100px; height: 100px; } }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="#about">Portfolio</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item"><a class="nav-link" href="#about">About Me</a></li>
                        <li class="nav-item"><a class="nav-link" href="#projects">Projects</a></li>
                        <li class="nav-item"><a class="nav-link" href="#contact">Contact</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main>
        <section id="about" class="section bg-light">
            <div class="container text-center">
                <img src="https://via.placeholder.com/150" alt="Profile Picture" class="profile-img">
                <h2>About Me</h2>
                <p id="greeting" class="text-effect h4"></p>
                <p>Hi, I'm Alex Johnson, a passionate web developer with over 5 years of experience in creating dynamic, user-friendly websites and applications. I specialize in front-end technologies like HTML5, CSS3, JavaScript, and frameworks such as Bootstrap and React. My journey started with a love for problem-solving and design, and I've since worked on projects ranging from e-commerce platforms to interactive dashboards.</p>
                <p><strong>Skills:</strong> HTML5, CSS3, JavaScript, jQuery, Bootstrap, Responsive Design, UI/UX Principles, Git, and basic back-end with Node.js.</p>
                <p><strong>Experience:</strong> I've collaborated with startups and agencies to build scalable web solutions. For example, I led the development of a travel booking site that improved user engagement by 40%. When I'm not coding, I enjoy hiking and contributing to open-source projects.</p>
                <p>Live Clock: <span id="clock"></span></p>
            </div>
        </section>
        <section id="projects" class="section">
            <div class="container">
                <h2>Projects</h2>
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">E-Commerce Platform</h5>
                                <p class="card-text">A fully responsive online store with payment integration.</p>
                                <p><strong>Technologies:</strong> HTML5, CSS3, JavaScript, Bootstrap</p>
                                <button class="btn btn-primary load-details" data-project="1">View Details</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Interactive Dashboard</h5>
                                <p class="card-text">A data visualization tool for employee metrics with theme switching.</p>
                                <p><strong>Technologies:</strong> HTML5, CSS3, JavaScript, jQuery, Bootstrap</p>
                                <button class="btn btn-primary load-details" data-project="2">View Details</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">Travel Booking App</h5>
                                <p class="card-text">A user-friendly app for searching and booking destinations.</p>
                                <p><strong>Technologies:</strong> HTML5, CSS3, JavaScript, jQuery, Bootstrap</p>
                                <button class="btn btn-primary load-details" data-project="3">View Details</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">E-Learning Portal</h5>
                                <p class="card-text">An educational platform with course listings and user login.</p>
                                <p><strong>Technologies:</strong> HTML5, CSS3, JavaScript, jQuery, Bootstrap</p>
                                <button class="btn btn-primary load-details" data-project="4">View Details</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section id="contact" class="section bg-light">
            <div class="container">
                <h2>Contact</h2>
                <form>
                    <input type="text" class="form-control mb-2" placeholder="Name">
                    <input type="email" class="form-control mb-2" placeholder="Email">
                    <textarea class="form-control mb-2" placeholder="Message"></textarea>
                    <button type="submit" class="btn btn-success">Send</button>
                </form>
            </div>
        </section>
    </main>
    <footer class="bg-dark text-white text-center p-3">
        <p>&copy; 2023 My Portfolio</p>
    </footer>
    <div class="modal fade" id="projectModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Project Details</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="projectContent"></div>
            </div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            // JavaScript for live clock and dynamic greetings
            function updateClock() {
                let now = new Date();
                $('#clock').text(now.toLocaleTimeString());
                let hour = now.getHours();
                let greeting = hour < 12 ? 'Good Morning!' : hour < 18 ? 'Good Afternoon!' : 'Good Evening!';
                $('#greeting').text(greeting);
            }
            setInterval(updateClock, 1000);
            updateClock();
            // Smooth animations
            $('.section').hide().fadeIn(1000);
            // jQuery for interactive navigation and dynamic loading
            $('a[href^="#"]').on('click', function(e) {
                e.preventDefault();
                let target = $(this).attr('href');
                $('html, body').animate({ scrollTop: $(target).offset().top }, 500);
            });
            $('.load-details').on('click', function() {
                let project = $(this).data('project');
                let details = {
                    1: '<p><strong>E-Commerce Platform:</strong> Built a responsive online store with product listings, shopping cart, and Stripe payment integration. Improved load times by 30% using optimized CSS and JS.</p><p><strong>Live Demo:</strong> <a href="#">Link</a></p>',
                    2: '<p><strong>Interactive Dashboard:</strong> Developed a metrics dashboard with real-time data, theme switching, and collapsible panels. Used jQuery for smooth interactions and Bootstrap for grid layout.</p><p><strong>Live Demo:</strong> <a href="#">Link</a></p>',
                    3: '<p><strong>Travel Booking App:</strong> Created a search-and-book interface with date pickers, filters, and modals. Ensured mobile responsiveness with Bootstrap and added validation with JavaScript.</p><p><strong>Live Demo:</strong> <a href="#">Link</a></p>',
                    4: '<p><strong>E-Learning Portal:</strong> Designed a homepage with course cards, login forms, and animations. Incorporated semantic HTML for accessibility and jQuery for sliding content.</p><p><strong>Live Demo:</strong> <a href="#">Link</a></p>'
                };
                $('#projectContent').html(details[project]);
                $('#projectModal').modal('show');
            });
        });
    </script>
</body>
</html>
